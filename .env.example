# FL Studio AI Assistant - Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ===== LLM Provider Configuration =====
# Supported providers: openai, anthropic, local
LLM_PROVIDER=openai

# OpenAI-compatible provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic provider
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Local model (e.g., Ollama, LM Studio)
LOCAL_MODEL_URL=http://localhost:11434
LOCAL_MODEL_NAME=

# ===== FL Studio MCP Integration =====
FL_MCP_HOST=localhost
FL_MCP_PORT=9000
FL_MCP_TIMEOUT_SECONDS=30

# ===== GUI Automation (HCU) =====
HCU_ENABLED=true
HCU_SCREENSHOT_DIR=

# ===== Backend Server =====
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8765
BACKEND_LOG_LEVEL=INFO

# ===== Database =====
DATABASE_URL=sqlite:///./data/fl_assistant.db

# ===== Security =====
# Use Windows Credential Manager for API keys when possible
USE_CREDENTIAL_MANAGER=true

# ===== Sample Library =====
# Comma-separated list of approved sample directories
# SAMPLE_DIRS=C:\Users\YourName\Samples,D:\Sample Library

# ===== Language =====
UI_LANGUAGE=tr

